{
  "name": "goalloop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/cli.ts serve --worker",
    "start": "node dist/cli.js serve --worker",
    "cli": "tsx src/cli.ts",
    "worker": "tsx src/cli.ts worker",
    "db:migrate": "tsx src/cli.ts init",
    "build": "tsc && pnpm --filter @goalloop/web build",
    "typecheck": "tsc --noEmit && pnpm --filter @goalloop/web typecheck",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration.test.ts",
    "test:e2e": "playwright test",
    "test:live": "tsx scripts/live.ts",
    "demo": "tsx src/cli.ts demo",
    "doctor": "tsx src/cli.ts doctor",
    "test:sdk": "tsx scripts/sdk-smoke.ts",
    "format": "prettier --write src apps/web/src scripts tests docs README.md",
    "format:check": "prettier --check src apps/web/src scripts tests docs README.md"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^14.0.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.5",
    "pg": "^8.16.3",
    "quickjs-emscripten": "^0.31.0",
    "smol-toml": "1.4.2",
    "yaml": "^2.8.1",
    "zod": "^4.0.0"
  },
  "optionalDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.296",
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "@deepseek-ai/dsh-sdk-client": "0.2.0-rc.2",
    "@langchain/core": "^1.2.14",
    "@langchain/langgraph-checkpoint-postgres": "1.0.6",
    "@langchain/openai": "1.6.2",
    "deepagents": "1.14.2",
    "langchain": "1.5.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "prettier": "3.6.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
