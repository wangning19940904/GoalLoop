DATABASE_URL=postgresql://localhost/goalloop
GOALLOOP_PORT=12400
GOALLOOP_DATA_DIR=.data
GOALLOOP_BASE_URL=http://127.0.0.1:12400
# Operator-installed, trusted capability modules (JSON array). Restart API and Worker together.
GOALLOOP_PACK_MODULES=[]
# Models are explicit for non-simulated runtimes. Credentials stay in the environment.
CODEX_BIN=codex
CODEX_MODEL=
CLAUDE_MODEL=
ANTHROPIC_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_API_KEY=
DEEPAGENTS_MODEL=
DEEPAGENTS_BASE_URL=https://api.deepseek.com
DEEPAGENTS_API_KEY=
FEISHU_WEBHOOK=
FEISHU_SECRET=
